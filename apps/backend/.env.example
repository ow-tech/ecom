NODE_ENV=development
BACKEND_PORT=4000
DATABASE_URL=postgresql://ecom:ecom_dev_password@127.0.0.1:5432/ecom_dev?schema=public
REDIS_URL=redis://127.0.0.1:6379
SESSION_COOKIE_NAME=ecom_session
COLLECTION_CODE_SECRET=CHANGE_ME_GENERATE_USING_OPENSSL_RAND_HEX_32
CHECKOUT_RESERVATION_TTL_MINUTES=15
RESERVATION_EXPIRY_BATCH_SIZE=100
DEFAULT_COMMISSION_RATE=0.10
RETURN_WINDOW_DAYS=30
PAYSTACK_ENVIRONMENT=test
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_OWN_TEST_SECRET
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_BASE_URL=http://localhost:3000
PAYSTACK_TIMEOUT_MS=10000
PAYSTACK_MPESA_ENABLED=false
HTTP_LOGGING=false

# Optional account recovery — backend only. Leave unset until a verified sender is configured.
RESEND_API_KEY=
ACCOUNT_EMAIL_FROM=
ACCOUNT_PUBLIC_URL=http://localhost:3100

# Free transactional staff invitations via Brevo: https://app.brevo.com
# Verify your sending domain and configure SPF/DKIM before production use.
# Keep the API key backend-only; never expose it through NEXT_PUBLIC_*.
BREVO_API_KEY=
STAFF_INVITATION_FROM_EMAIL=
STAFF_INVITATION_FROM_NAME=Ecom

# Server-only AES-256-GCM key for encrypted supplier payout instructions.
# Generate with openssl rand -hex 32. NEVER commit a real value.
PAYOUT_DETAILS_ENCRYPTION_KEY=
