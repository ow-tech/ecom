generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountAudience {
  CUSTOMER
  WORKFORCE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum RoleScope {
  PLATFORM
  ORGANIZATION
}

enum SupplierStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
}

enum SupplierListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ProductMediaType {
  IMAGE
}

enum InventoryLocationType {
  WAREHOUSE
  STORE
  OTHER
}

enum InventoryLocationStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum CheckoutAttemptStatus {
  STARTED
  ORDER_CREATED
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_DELIVERY_QUOTE
  PAYMENT_CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  PAYMENT_REVIEW
  CANCELLED
  EXPIRED
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  PAID_REVIEW
}

enum SupplierOrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  READY_FOR_DISPATCH
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PickupPointStatus {
  ACTIVE
  INACTIVE
}

enum DeliveryZoneStatus {
  ACTIVE
  INACTIVE
}

enum DeliveryRateStatus {
  ACTIVE
  INACTIVE
}

enum DeliveryQuoteStatus {
  PENDING
  QUOTED
  APPROVED
  DECLINED
  EXPIRED
}

enum PaymentProvider {
  PAYSTACK
}

enum PaymentStatus {
  INITIALIZATION_PENDING
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  UNKNOWN
}

enum PaymentEventProcessingResult {
  RECEIVED
  IGNORED
  DUPLICATE
  SETTLED
  PAYMENT_REVIEW
  FAILED_BINDING
  NON_SUCCESS
  ERROR
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum OrderRefundStatus {
  NONE
  PARTIAL
  FULL
}

enum RefundRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REFUND_PENDING
  REFUNDED
  REJECTED
  FAILED
  CANCELLED
}

enum RefundStatus {
  CREATED
  PENDING
  UNKNOWN
  REFUNDED
  FAILED
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  AWAITING_ITEM
  ITEM_RECEIVED
  INSPECTING
  COMPLETED
  CANCELLED
}

enum ReturnReasonCode {
  DAMAGED
  WRONG_ITEM
  DEFECTIVE
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum ReturnResolution {
  REFUND
  REPLACEMENT
  NO_ACTION
}

enum WarrantyClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IN_SERVICE
  RESOLVED
}

enum WarrantyResolution {
  REPAIR
  REPLACEMENT
  REFUND
  NO_FAULT_FOUND
}

enum CommissionRecordStatus {
  EARNED
}

enum SupplierLedgerEntryType {
  SUPPLIER_EARNING
  REFUND_DEBIT
  MANUAL_ADJUSTMENT
  SETTLEMENT_DEBIT
}

enum SupplierSettlementStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum OperationalOutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum NotificationStatus {
  AVAILABLE
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationDeliveryStatus {
  AVAILABLE
  FAILED
  NOT_CONFIGURED
  SUCCEEDED
}

enum SupportTicketOrigin {
  CUSTOMER
  SUPPLIER
}

enum SupportCategory {
  ORDER
  PAYMENT
  DELIVERY
  REFUND
  RETURN
  WARRANTY
  PRODUCT
  ACCOUNT
  SUPPLIER
  OTHER
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  WAITING_FOR_INTERNAL
  RESOLVED
  CLOSED
}

enum SupportMessageVisibility {
  PUBLIC
  INTERNAL
}

model User {
  id                       String                       @id @default(uuid()) @db.Uuid
  email                    String
  emailNormalized          String                       @unique
  accountAudience          AccountAudience              @default(CUSTOMER)
  displayName              String?
  status                   UserStatus                   @default(ACTIVE)
  emailVerifiedAt          DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  credential               Credential?
  sessions                 Session[]
  passwordResetToken       PasswordResetToken?
  memberships              OrganizationMembership[]
  platformRoles            PlatformRoleAssignment[]
  approvedSuppliers        Supplier[]                   @relation("SupplierApprovedBy")
  rejectedSuppliers        Supplier[]                   @relation("SupplierRejectedBy")
  suspendedSuppliers       Supplier[]                   @relation("SupplierSuspendedBy")
  supplierStatusHistory    SupplierStatusHistory[]
  inventoryMovements       InventoryMovement[]          @relation("InventoryMovementActor")
  customerProfile          CustomerProfile?
  orderStatusHistory       OrderStatusHistory[]         @relation("OrderStatusActor")
  supplierOrderHistory     SupplierOrderStatusHistory[] @relation("SupplierOrderStatusActor")
  calculatedQuotes         DeliveryQuote[]              @relation("DeliveryQuoteCalculator")
  reviewedRefundRequests   RefundRequest[]              @relation("RefundRequestReviewer")
  returnStatusHistory      ReturnStatusHistory[]        @relation("ReturnStatusActor")
  warrantyStatusHistory    WarrantyStatusHistory[]      @relation("WarrantyStatusActor")
  reviewedWarrantyClaims   WarrantyClaim[]              @relation("WarrantyReviewer")
  createdSettlements       SupplierSettlement[]         @relation("SettlementCreator")
  approvedSettlements      SupplierSettlement[]         @relation("SettlementApprover")
  paidSettlements          SupplierSettlement[]         @relation("SettlementPaidBy")
  manualLedgerEntries      SupplierLedgerEntry[]        @relation("LedgerActor")
  platformCommissionRates  PlatformCommissionRate[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  requestedSupportTickets  SupportTicket[]              @relation("SupportRequester")
  assignedSupportTickets   SupportTicket[]              @relation("SupportAssignee")
  supportMessages          SupportMessage[]             @relation("SupportMessageAuthor")
  supportStatusHistory     SupportTicketStatusHistory[] @relation("SupportStatusActor")
  supportAssignmentActions SupportAssignmentHistory[]   @relation("SupportAssignmentActor")
  auditEvents              AuditEvent[]                 @relation("AuditActor")
}

model Credential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  passwordHash      String
  passwordUpdatedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A single short-lived, single-use recovery challenge. No raw token is stored.
model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

// Cross-replica authentication throttle; keys are SHA-256 digests, not emails/IPs.
model AuthLoginThrottle {
  key             String   @id
  failures        Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt
}

model Organization {
  id             String                   @id @default(uuid()) @db.Uuid
  name           String
  slug           String                   @unique
  status         OrganizationStatus       @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  memberships    OrganizationMembership[]
  supplier       Supplier?
  supportTickets SupportTicket[]
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles          MembershipRole[]

  @@unique([organizationId, userId])
}

model Role {
  id                  String                   @id @default(uuid()) @db.Uuid
  key                 String                   @unique
  name                String
  description         String?
  scope               RoleScope
  isSystem            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  permissions         RolePermission[]
  membershipRoles     MembershipRole[]
  platformAssignments PlatformRoleAssignment[]
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  description     String
  scope           RoleScope
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MembershipRole {
  membershipId String                 @db.Uuid
  roleId       String                 @db.Uuid
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

model PlatformRoleAssignment {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Supplier {
  id                 String                   @id @default(uuid()) @db.Uuid
  organizationId     String                   @unique @db.Uuid
  displayName        String                   @db.VarChar(120)
  legalName          String?                  @db.VarChar(160)
  slug               String                   @unique @db.VarChar(140)
  status             SupplierStatus           @default(DRAFT)
  description        String?
  businessEmail      String?                  @db.VarChar(320)
  businessPhone      String?                  @db.VarChar(40)
  websiteUrl         String?                  @db.VarChar(2048)
  logoUrl            String?                  @db.VarChar(2048)
  bannerUrl          String?                  @db.VarChar(2048)
  countryCode        String?                  @db.VarChar(2)
  currencyCode       String?                  @db.VarChar(3)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  approvedAt         DateTime?
  approvedByUserId   String?                  @db.Uuid
  rejectedAt         DateTime?
  rejectedByUserId   String?                  @db.Uuid
  rejectionReason    String?                  @db.VarChar(1000)
  suspendedAt        DateTime?
  suspendedByUserId  String?                  @db.Uuid
  suspensionReason   String?                  @db.VarChar(1000)
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedByUser     User?                    @relation("SupplierApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  rejectedByUser     User?                    @relation("SupplierRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: Restrict)
  suspendedByUser    User?                    @relation("SupplierSuspendedBy", fields: [suspendedByUserId], references: [id], onDelete: Restrict)
  statusHistory      SupplierStatusHistory[]
  listings           SupplierListing[]
  inventoryLocations InventoryLocation[]
  supplierOrders     SupplierOrder[]
  orderItems         OrderItem[]
  commissionRates    SupplierCommissionRate[]
  commissions        CommissionRecord[]
  ledgerEntries      SupplierLedgerEntry[]
  settlements        SupplierSettlement[]
  payoutDestinations SupplierPayoutDestination[]
  supportTickets     SupportTicket[]

  @@index([status])
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(160)
  slug        String         @unique @db.VarChar(180)
  description String?
  parentId    String?        @db.Uuid
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]     @relation("CategoryHierarchy")
  products    Product[]

  @@index([parentId])
  @@index([status, sortOrder])
}

model Product {
  id          String            @id @default(uuid()) @db.Uuid
  categoryId  String            @db.Uuid
  name        String            @db.VarChar(200)
  slug        String            @unique @db.VarChar(220)
  brand       String?           @db.VarChar(120)
  description String?
  status      ProductStatus     @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  listings    SupplierListing[]
  media       ProductMedia[]
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id         String               @id @default(uuid()) @db.Uuid
  productId  String               @db.Uuid
  name       String               @db.VarChar(200)
  sku        String?              @unique @db.VarChar(120)
  attributes Json                 @default("{}")
  status     ProductVariantStatus @default(ACTIVE)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  product    Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  listings   SupplierListing[]
  media      ProductMedia[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([status])
}

model SupplierListing {
  id                  String                @id @default(uuid()) @db.Uuid
  supplierId          String                @db.Uuid
  productId           String                @db.Uuid
  productVariantId    String?               @db.Uuid
  supplierSku         String?               @db.VarChar(120)
  titleOverride       String?               @db.VarChar(200)
  descriptionOverride String?
  price               Decimal               @db.Decimal(18, 2)
  currencyCode        String                @db.VarChar(3)
  status              SupplierListingStatus @default(DRAFT)
  warrantyDays        Int?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  supplier            Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  product             Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant      ProductVariant?       @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  inventoryItems      InventoryItem[]
  cartItems           CartItem[]
  orderItems          OrderItem[]

  @@index([supplierId, status])
  @@index([productId, status])
}

model ProductMedia {
  id               String           @id @default(uuid()) @db.Uuid
  productId        String           @db.Uuid
  productVariantId String?          @db.Uuid
  storageKey       String           @db.VarChar(1024)
  url              String?          @db.VarChar(2048)
  altText          String?          @db.VarChar(500)
  sortOrder        Int              @default(0)
  mediaType        ProductMediaType @default(IMAGE)
  createdAt        DateTime         @default(now())
  product          Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant?  @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@index([productVariantId])
}

model SupplierStatusHistory {
  id             String          @id @default(uuid()) @db.Uuid
  supplierId     String          @db.Uuid
  previousStatus SupplierStatus?
  newStatus      SupplierStatus
  actorUserId    String          @db.Uuid
  reason         String?         @db.VarChar(1000)
  createdAt      DateTime        @default(now())
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  actorUser      User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([supplierId, createdAt])
}

model InventoryLocation {
  id             String                  @id @default(uuid()) @db.Uuid
  supplierId     String                  @db.Uuid
  name           String                  @db.VarChar(160)
  code           String                  @db.VarChar(80)
  description    String?
  type           InventoryLocationType   @default(WAREHOUSE)
  status         InventoryLocationStatus @default(ACTIVE)
  addressLine1   String?                 @db.VarChar(200)
  addressLine2   String?                 @db.VarChar(200)
  city           String?                 @db.VarChar(120)
  region         String?                 @db.VarChar(120)
  countryCode    String?                 @db.VarChar(2)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  supplier       Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  inventoryItems InventoryItem[]

  @@unique([supplierId, code])
  @@index([supplierId, status])
}

model InventoryItem {
  id                  String                 @id @default(uuid()) @db.Uuid
  supplierListingId   String                 @db.Uuid
  inventoryLocationId String                 @db.Uuid
  onHand              Int                    @default(0)
  reserved            Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  supplierListing     SupplierListing        @relation(fields: [supplierListingId], references: [id], onDelete: Restrict)
  inventoryLocation   InventoryLocation      @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  movements           InventoryMovement[]
  reservations        InventoryReservation[]

  @@unique([supplierListingId, inventoryLocationId])
  @@index([inventoryLocationId])
}

model CustomerProfile {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @unique @db.Uuid
  firstName        String?           @db.VarChar(120)
  lastName         String?           @db.VarChar(120)
  phone            String?           @db.VarChar(40)
  alternativePhone String?           @db.VarChar(40)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses        CustomerAddress[]
  carts            Cart[]
  checkoutAttempts CheckoutAttempt[]
  orders           Order[]
  refundRequests   RefundRequest[]
  returnRequests   ReturnRequest[]
  warrantyClaims   WarrantyClaim[]
  supportTickets   SupportTicket[]
}

model CustomerAddress {
  id                String          @id @default(uuid()) @db.Uuid
  customerProfileId String          @db.Uuid
  label             String?         @db.VarChar(80)
  recipientName     String          @db.VarChar(200)
  phone             String          @db.VarChar(40)
  alternativePhone  String?         @db.VarChar(40)
  countryCode       String          @db.VarChar(2)
  region            String          @db.VarChar(120)
  city              String          @db.VarChar(120)
  estate            String?         @db.VarChar(160)
  street            String?         @db.VarChar(200)
  building          String?         @db.VarChar(160)
  houseNumber       String?         @db.VarChar(80)
  landmark          String?         @db.VarChar(240)
  latitude          Decimal?        @db.Decimal(10, 7)
  longitude         Decimal?        @db.Decimal(10, 7)
  deliveryNotes     String?         @db.VarChar(1000)
  isDefault         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([customerProfileId, createdAt])
}

model Cart {
  id                String            @id @default(uuid()) @db.Uuid
  customerProfileId String            @db.Uuid
  status            CartStatus        @default(ACTIVE)
  currencyCode      String?           @db.VarChar(3)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  customerProfile   CustomerProfile   @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  items             CartItem[]
  checkoutAttempts  CheckoutAttempt[]

  @@index([customerProfileId, createdAt])
}

model CartItem {
  id                String          @id @default(uuid()) @db.Uuid
  cartId            String          @db.Uuid
  supplierListingId String          @db.Uuid
  quantity          Int
  unitPriceSnapshot Decimal         @db.Decimal(18, 2)
  currencyCode      String          @db.VarChar(3)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  supplierListing   SupplierListing @relation(fields: [supplierListingId], references: [id], onDelete: Restrict)

  @@unique([cartId, supplierListingId])
  @@index([supplierListingId])
}

model CheckoutAttempt {
  id                String                 @id @default(uuid()) @db.Uuid
  customerProfileId String                 @db.Uuid
  cartId            String                 @db.Uuid
  idempotencyKey    String                 @db.VarChar(200)
  status            CheckoutAttemptStatus  @default(STARTED)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  customerProfile   CustomerProfile        @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  cart              Cart                   @relation(fields: [cartId], references: [id], onDelete: Restrict)
  order             Order?
  reservations      InventoryReservation[]

  @@unique([customerProfileId, idempotencyKey])
  @@index([cartId])
}

model Order {
  id                      String                 @id @default(uuid()) @db.Uuid
  orderNumber             String                 @unique @db.VarChar(40)
  customerProfileId       String                 @db.Uuid
  checkoutAttemptId       String                 @unique @db.Uuid
  status                  OrderStatus            @default(PENDING_PAYMENT)
  paymentStatus           OrderPaymentStatus     @default(UNPAID)
  refundStatus            OrderRefundStatus      @default(NONE)
  currencyCode            String                 @db.VarChar(3)
  subtotal                Decimal                @db.Decimal(18, 2)
  deliveryFee             Decimal                @default(0) @db.Decimal(18, 2)
  pickupFee               Decimal                @default(0) @db.Decimal(18, 2)
  total                   Decimal                @db.Decimal(18, 2)
  fulfillmentMethod       FulfillmentMethod
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  cancelledAt             DateTime?
  collectionCodeHash      String?                @db.VarChar(64)
  collectionCodeExpiresAt DateTime?
  collectedAt             DateTime?
  customerProfile         CustomerProfile        @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  checkoutAttempt         CheckoutAttempt        @relation(fields: [checkoutAttemptId], references: [id], onDelete: Restrict)
  deliveryAddress         OrderDeliveryAddress?
  pickupSnapshot          OrderPickupSnapshot?
  deliveryQuote           DeliveryQuote?
  items                   OrderItem[]
  supplierOrders          SupplierOrder[]
  statusHistory           OrderStatusHistory[]
  reservations            InventoryReservation[]
  payments                Payment[]
  refundRequests          RefundRequest[]
  returnRequests          ReturnRequest[]

  @@index([customerProfileId, createdAt])
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @db.Uuid
  provider          PaymentProvider @default(PAYSTACK)
  providerReference String          @db.VarChar(120)
  idempotencyKey    String          @db.VarChar(200)
  status            PaymentStatus   @default(INITIALIZATION_PENDING)
  currencyCode      String          @db.VarChar(3)
  amount            Decimal         @db.Decimal(18, 2)
  customerEmail     String          @db.VarChar(320)
  requestedChannel  String?         @db.VarChar(80)
  authorizationUrl  String?         @db.VarChar(2048)
  accessCode        String?         @db.VarChar(500)
  providerAmount    Decimal?        @db.Decimal(30, 0)
  providerCurrency  String?         @db.VarChar(3)
  providerStatus    String?         @db.VarChar(80)
  providerCode      String?         @db.VarChar(160)
  providerChannel   String?         @db.VarChar(80)
