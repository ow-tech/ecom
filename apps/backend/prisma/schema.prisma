  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  recipientUser    User                          @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  deliveryAttempts NotificationDeliveryAttempt[]

  @@index([recipientUserId, readAt, createdAt])
}

model NotificationDeliveryAttempt {
  id                String                     @id @default(uuid()) @db.Uuid
  notificationId    String                     @db.Uuid
  channel           NotificationChannel
  provider          String?                    @db.VarChar(80)
  status            NotificationDeliveryStatus
  attemptNumber     Int
  providerMessageId String?                    @db.VarChar(200)
  startedAt         DateTime                   @default(now())
  completedAt       DateTime?
  errorCode         String?                    @db.VarChar(120)
  errorMessage      String?                    @db.VarChar(1000)
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@unique([notificationId, channel, attemptNumber])
}

model NotificationPreference {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  category     String   @db.VarChar(40)
  inAppEnabled Boolean  @default(true)
  emailEnabled Boolean  @default(false)
  smsEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model SupportTicket {
  id                 String                       @id @default(uuid()) @db.Uuid
  ticketNumber       String                       @unique @db.VarChar(40)
  origin             SupportTicketOrigin
  requesterUserId    String                       @db.Uuid
  customerProfileId  String?                      @db.Uuid
  organizationId     String?                      @db.Uuid
  supplierId         String?                      @db.Uuid
  category           SupportCategory
  priority           SupportPriority              @default(NORMAL)
  status             SupportTicketStatus          @default(OPEN)
  subject            String                       @db.VarChar(240)
  relatedEntityType  String?                      @db.VarChar(80)
  relatedEntityId    String?                      @db.VarChar(120)
  assignedToUserId   String?                      @db.Uuid
  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?
  closedAt           DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  requesterUser      User                         @relation("SupportRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  customerProfile    CustomerProfile?             @relation(fields: [customerProfileId], references: [id], onDelete: Restrict)
  organization       Organization?                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier           Supplier?                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  assignedToUser     User?                        @relation("SupportAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  messages           SupportMessage[]
  statusHistory      SupportTicketStatusHistory[]
  assignmentHistory  SupportAssignmentHistory[]

  @@index([status, priority, resolutionDueAt])
  @@index([customerProfileId, createdAt])
  @@index([organizationId, createdAt])
}

model SupportMessage {
  id           String                   @id @default(uuid()) @db.Uuid
  ticketId     String                   @db.Uuid
  authorUserId String                   @db.Uuid
  visibility   SupportMessageVisibility
  body         String                   @db.VarChar(4000)
  createdAt    DateTime                 @default(now())
  ticket       SupportTicket            @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  authorUser   User                     @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model SupportTicketStatusHistory {
  id             String               @id @default(uuid()) @db.Uuid
  ticketId       String               @db.Uuid
  previousStatus SupportTicketStatus?
  newStatus      SupportTicketStatus
  actorUserId    String               @db.Uuid
  reason         String?              @db.VarChar(1000)
  createdAt      DateTime             @default(now())
  ticket         SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actorUser      User                 @relation("SupportStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model SupportAssignmentHistory {
  id                     String        @id @default(uuid()) @db.Uuid
  ticketId               String        @db.Uuid
  previousAssigneeUserId String?       @db.Uuid
  newAssigneeUserId      String        @db.Uuid
  actorUserId            String        @db.Uuid
  createdAt              DateTime      @default(now())
  ticket                 SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actorUser              User          @relation("SupportAssignmentActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @db.Uuid
  actorType      String   @db.VarChar(40)
  organizationId String?  @db.Uuid
  action         String   @db.VarChar(120)
  entityType     String   @db.VarChar(80)
  entityId       String?  @db.VarChar(120)
  requestId      String?  @db.VarChar(120)
  dedupeKey      String?  @unique @db.VarChar(240)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  actorUser      User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
}
